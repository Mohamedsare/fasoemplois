# Copiez ce fichier en .env.local puis remplissez les valeurs
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Clé service_role : SECRÈTE, contourne la RLS. Serveur uniquement, jamais de préfixe NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (liens des e-mails de confirmation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paiement : "simulation" = aucun paiement réel (défaut en développement uniquement).
# En production, laisser vide désactive le paiement ; ne jamais y mettre "simulation".
PAYMENT_PROVIDER=simulation

# Jeton personnel Supabase (supabase.com/dashboard/account/tokens) pour `npm run db:migrate`
TOKEN=
