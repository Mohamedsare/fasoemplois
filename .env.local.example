# Copiez ce fichier en .env.local puis remplissez les valeurs
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Clé service_role : SECRÈTE, contourne la RLS. Serveur uniquement, jamais de préfixe NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (liens des e-mails de confirmation). Production : https://votrecv.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paiement : "orange_money" (défaut) = dépôt Orange Money + ID de transaction, validé par l'admin.
# "simulation" = paiement fictif pour le développement uniquement (jamais en production).
PAYMENT_PROVIDER=orange_money

# Jeton personnel Supabase (supabase.com/dashboard/account/tokens) pour `npm run db:migrate`
TOKEN=

# Assistant IA du créateur de CV (platform.openai.com > API keys). SECRÈTE, serveur uniquement.
OPENAI_API_KEY=
# Modèle utilisé (facultatif). Défaut : gpt-6.1-sol. Plus puissant : gpt-6-astra ; moins cher : gpt-6-luna
OPENAI_MODEL=

# Pixel Meta (Facebook), actif en production uniquement. Facultatif : l'ID par défaut est déjà dans le code.
NEXT_PUBLIC_META_PIXEL_ID=
